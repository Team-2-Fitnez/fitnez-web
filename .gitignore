# Environment / secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
socketio/.env
socketio/.env.*
!socketio/.env.example

# Dependencies
node_modules/
**/node_modules/
vendor/
backend/vendor/
socketio/node_modules/

# Docker / infra local-only files
# Keep source infra files tracked: docker-compose.yml, nginx.conf, Dockerfile, and reusable docker configs.
docker-compose.override.yml
docker-compose.*.local.yml
.docker/
**/.docker/

# Build outputs
frontend/dist/
backend/public/build/
backend/public/hot
socketio/dist/
socketio/coverage/

# Unit tests
frontend/src/__tests__/
frontend/**/__tests__/
frontend/**/*.spec.*
frontend/**/*.test.*
frontend/vitest.config.*
frontend/tsconfig.vitest.json
frontend/coverage/
backend/tests/
backend/**/tests/
backend/**/*Test.php
backend/**/*.spec.*
backend/**/*.test.*
backend/test_*.php
backend/phpunit.xml
backend/phpunit.xml.dist

# Laravel runtime data
backend/storage/logs/*.log
backend/storage/framework/cache/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/app/public/*
backend/storage/app/private/*
backend/bootstrap/cache/*.php
!backend/storage/app/.gitignore
!backend/storage/app/public/.gitignore
!backend/storage/app/private/.gitignore
!backend/storage/framework/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore
!backend/bootstrap/cache/.gitignore

# Databases / generated files
backend/database/*.sqlite
*.sqlite
*.db

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
*.tmp
*.temp

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# Windows Mark of the Web metadata copied into WSL/Linux
*:Zone.Identifier
Zone.Identifier
